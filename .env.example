# Copia este archivo como .env y ajusta a tu gusto. Nada de esto es secreto.

# Tecla o combo para mantener pulsado mientras hablas.
# Ejemplos válidos: ctrl+win, f9, f12, ctrl+alt+d, ctrl+space
# ctrl+win (sin tercera tecla) no choca con nada de Windows: los atajos de
# escritorio virtual son Ctrl+Win+D/F4/Izq/Der, no Ctrl+Win solo.
VOZDOO_HOTKEY=ctrl+win

# Modelo de Whisper: tiny, base, small, medium, large-v3
# tiny/base = más rápido y menos preciso. small = buen equilibrio.
# medium/large-v3 = más preciso, más lento y más RAM/VRAM.
VOZDOO_WHISPER_MODEL=small

# Idioma forzado (evita que Whisper detecte mal el idioma en frases cortas)
VOZDOO_WHISPER_LANGUAGE=es

# auto (intenta GPU y cae a CPU si falla), cpu, o cuda
VOZDOO_WHISPER_DEVICE=auto

# Índice o nombre del micrófono a usar. Déjalo vacío para el micro por
# defecto del sistema. Ejecuta list_devices.py para ver los disponibles.
VOZDOO_MIC_DEVICE=

VOZDOO_SAMPLE_RATE=16000
VOZDOO_MAX_RECORDING_SECONDS=30

# true: pega el texto automáticamente donde tengas el cursor (simula Ctrl+V)
# false: solo lo deja copiado en el portapapeles, lo pegas tú manualmente
VOZDOO_AUTO_PASTE=true

# --- Asistente de prompts y textos (IA local con Ollama) ---

# Tecla o combo para hablar con el asistente: mantenla pulsada y di la
# orden ("optimiza prompt profesional: ...", "pasa esto a texto legal").
# No puede compartir todas las teclas de VOZDOO_HOTKEY.
VOZDOO_POLISH_HOTKEY=alt+win

# Si rellenas esto, se usa tu propia API en vez de Ollama local.
# Gemini: crea una clave gratis en https://aistudio.google.com/apikey y
# pon VOZDOO_LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
VOZDOO_LLM_API_KEY=
VOZDOO_LLM_API_URL=https://api.openai.com/v1/chat/completions
VOZDOO_LLM_API_MODEL=gpt-4o-mini

# Si no hay API key, se usa Ollama local con este modelo (2,5 GB, buen
# español). Ordenador justo de memoria (8 GB o menos): qwen2.5:3b-instruct.
VOZDOO_LLM_MODEL=qwen3:4b-instruct
VOZDOO_LLM_HOST=http://localhost:11434
